# Backend server port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Dedicated MongoDB connection string for tests
MONGO_URI_TEST=mongodb+srv://<username>:<password>@<cluster>/notes-app_test?retryWrites=true&w=majority&appName=Cluster0

# Development mode keeps pino-pretty enabled locally
NODE_ENV=development

# JWT Secret Key – set a long random string in production
JWT_SECRET=

# Logging level for the application.
LOG_LEVEL=info